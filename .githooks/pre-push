#!/bin/sh

set -u

override_value="I_REMEMBER_AND_INSIST"
zero_sha="0000000000000000000000000000000000000000"
blocked=0

while read local_ref local_sha remote_ref remote_sha; do
    case "$local_ref $remote_ref" in
        *refs/heads/gold/*)
            if [ "${LSX4_GOLD_PUSH_CONFIRM:-}" != "$override_value" ]; then
                echo >&2 "GOLD push blocked by the local LSX4 safety gate."
                echo >&2 "Gold is local-only by policy. Confirm the warning explicitly before retrying."
                echo >&2 "After the owner says they remember the risk and still insist, retry with:"
                echo >&2 "  LSX4_GOLD_PUSH_CONFIRM=$override_value git push ..."
                blocked=1
            fi
            ;;
    esac

    # A deletion is already covered by the Gold ref-name check and needs no object lookup.
    if [ "$local_sha" = "$zero_sha" ]; then
        continue
    fi
done

if [ "$blocked" -ne 0 ]; then
    exit 1
fi

exit 0
